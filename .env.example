# ========================================
# ByteBerry Expenses API - Environment Variables
# ========================================

# ========================================
# 🔧 APPLICATION CONFIG (F0+)
# ========================================

# Node Environment
# Valores: development | production | test
NODE_ENV=development

# Server Port
# Expenses API escucha en puerto 4001 internamente
PORT=4001

# Service Name
# Nombre del servicio para logs y monitoreo
SERVICE_NAME=ByteBerry-Expenses

# Service URL
# URL pública del servicio de Expenses (sin puerto)
SERVICE_URL=http://localhost

# ========================================
# 📝 LOGGING CONFIG (F0+)
# ========================================

# Log Level
# Valores: error | warn | info | debug | trace
LOG_LEVEL=debug

# Log Requests (registrar todas las peticiones HTTP)
LOG_REQUESTS=true


# ========================================
# 🗄️ DATABASE CONFIG (F2+)
# ========================================

# PostgreSQL Connection URL
# Formato: postgresql://user:password@host:port/database?schema=public
#
# Development (local):
DATABASE_URL=postgresql://expenses:expenses_password@localhost:5433/expenses_dev?schema=public
#
# Production (Docker Compose):
# DATABASE_URL=postgresql://expenses:${POSTGRES_PASSWORD}@expenses-db:5432/expenses?schema=public
#
# Test:
# DATABASE_URL=postgresql://expenses:expenses_password@localhost:5433/expenses_test?schema=public

# Database Connection Pool Settings
# Minimum number of connections in the pool
DATABASE_POOL_MIN=2

# Maximum number of connections in the pool
DATABASE_POOL_MAX=10


# ========================================
# 🔐 JWT VALIDATION CONFIG (F1+)
# ========================================

# JWT Issuer (quien emite el token - debe coincidir con OAuth2)
# Debe ser la URL del servicio OAuth2
JWT_ISSUER=https://byteberry.jrmdev.org

# JWT Audience (para quién es el token - validación)
# Este servicio valida que el token sea para él
JWT_AUDIENCE=byteberry-api

# JWKS Cache TTL (tiempo en segundos)
# Tiempo que se cachean las llaves públicas antes de refrescar
JWKS_CACHE_TTL=3600

# JWKS Cache Max Age (tiempo máximo en segundos)
# Tiempo máximo antes de forzar refresh del JWKS
JWKS_CACHE_MAX_AGE=86400


# ========================================
# 🔒 SECURITY CONFIG (F0+)
# ========================================

# CORS Allowed Origins
# Lista separada por comas de orígenes permitidos
# Development:
CORS_ORIGINS=http://localhost:5173,http://localhost:4003,http://localhost:4002
# Production:
# CORS_ORIGINS=https://byteberry.jrmdev.org


# ========================================
# 🚀 EXTERNAL SERVICES (F1+)
# ========================================

# OAuth2 Service URL
# URL interna del servicio OAuth2 para validación de tokens
OAUTH2_SERVICE_URL=http://oauth2-service:4000

# OAuth2 JWKS Endpoint
# URL pública donde obtener las llaves públicas para validar JWT
OAUTH2_JWKS_URL=https://byteberry.jrmdev.org/auth/.well-known/jwks.json
#
# Development (local sin proxy):
# OAUTH2_JWKS_URL=http://localhost:4000/.well-known/jwks.json


# ========================================
# 💾 REDIS CONFIG (F6+)
# ========================================

# Redis Connection URL
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0


# ========================================
# 📧 EMAIL CONFIG (F6+)
# ========================================

# Email Service Provider
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=noreply@byteberry.jrmdev.org
#
# SMTP Config:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=


# ========================================
# 📊 MONITORING CONFIG (F0+)
# ========================================

# Health Check Interval (milliseconds)
# Intervalo para verificar salud de dependencias
HEALTH_CHECK_INTERVAL=30000

# Health Check Timeout (milliseconds)
# Timeout para health checks de dependencias
HEALTH_CHECK_TIMEOUT=5000
